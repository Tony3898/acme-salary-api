# Copy to .env for local development. Real values are never committed.

NODE_ENV=development
PORT=3000

# Must match docker-compose.yml
DATABASE_URL=postgresql://acme:acme_local_dev@localhost:5432/acme_salary

# Signs access tokens. No default exists — generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Password for the seeded demo logins. Change this for any public deployment.
SEED_DEMO_PASSWORD=AcmeDemo!2026

# Exact origin of the UI. Comma-separated if more than one. No wildcards:
# credentials are sent as cookies, which requires an exact origin.
CORS_ORIGIN=http://localhost:5173
