# Copy to .env for local development. Real values are never committed.

NODE_ENV=development
PORT=3000

# Must match docker-compose.yml
DATABASE_URL=postgresql://acme:acme_local_dev@localhost:5432/acme_salary

# Exact origin of the UI. Comma-separated if more than one. No wildcards:
# credentials are sent as cookies, which requires an exact origin.
CORS_ORIGIN=http://localhost:5173
