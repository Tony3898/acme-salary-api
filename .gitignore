# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Tests
coverage/
.jest-cache/

# Environment — never commit real values, see .env.example
.env
.env.*
!.env.example

# Local database volume (docker compose)
.pgdata/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
# Shared so the editor lints the same way the command line does — without
# this the extension runs from the wrong directory in a multi-project window
# and reports every imported type as unresolvable.
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# CDK. cdk.out holds synthesised templates and the assets they reference — generated
# from infra/, and large enough that reviewing a diff of it is nobody's job.
infra/cdk.out/
infra/node_modules/

# Temporary
tmp/
*.tmp
.cache/
