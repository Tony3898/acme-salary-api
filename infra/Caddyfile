# TLS for the API, which exists because the UI is served over HTTPS from CloudFront
# and a browser will not let an HTTPS page call an HTTP one.
#
# Caddy rather than nginx plus certbot: naming the domain is the whole configuration,
# and the certificate is obtained and renewed without a cron job to forget about.
{$API_DOMAIN} {
	encode gzip

	reverse_proxy api:3000 {
		# The API reads the client IP from here to rate-limit logins per address, so
		# TRUST_PROXY_HOPS is 1 in .env — one proxy, this one. Caddy overwrites rather
		# than appends, which is what makes the header safe to trust: a client that
		# sends its own X-Forwarded-For cannot spread its login attempts across
		# invented addresses.
		header_up X-Forwarded-For {remote_host}
	}

	# HSTS. Caddy already redirects HTTP to HTTPS; this stops the first request of the
	# next visit from being plaintext at all. No `preload`, no `includeSubDomains` —
	# this is a subdomain of somebody's personal domain and those are hard to undo.
	header Strict-Transport-Security "max-age=31536000"

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
